// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  roleId        Int
  role          Role           @relation(fields: [roleId], references: [id])
  bookings      Booking[]
  notifications Notification[]
  favorites     Favorite[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  files         File[]
  refreshTokens RefreshToken[]
  eventLogs     UserEvent[]
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  resources Resource[]
}

model Resource {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  location    String
  price       Float
  categoryId  Int
  category    Category   @relation(fields: [categoryId], references: [id])
  bookings    Booking[]
  favorites   Favorite[]
  createdAt   DateTime   @default(now())

  @@index([categoryId, createdAt])
  @@index([price])
  @@index([name])
  @@index([createdAt])
}

model Booking {
  id         Int           @id @default(autoincrement())
  userId     Int
  resourceId Int
  startTime  DateTime
  endTime    DateTime
  status     BookingStatus @default(PENDING)
  user       User          @relation(fields: [userId], references: [id])
  resource   Resource      @relation(fields: [resourceId], references: [id])
  createdAt  DateTime      @default(now())

  // Індекс для отримання бронювань користувача за датою створення
  @@index([userId, createdAt])
  // Індекс для пошуку конфліктів бронювання ресурсу
  @@index([resourceId, status, startTime])
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id        Int                  @id @default(autoincrement())
  userId    Int
  message   String
  isRead    Boolean              @default(false)
  priority  NotificationPriority @default(NORMAL)
  user      User                 @relation(fields: [userId], references: [id])
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([priority, createdAt])
}

model Favorite {
  userId     Int
  resourceId Int
  user       User     @relation(fields: [userId], references: [id])
  resource   Resource @relation(fields: [resourceId], references: [id])
  createdAt  DateTime @default(now())

  @@id([userId, resourceId])
}

model File {
  id           Int      @id @default(autoincrement())
  filename     String
  originalName String
  mimetype     String
  size         Int
  path         String
  uploadedBy   Int
  createdAt    DateTime @default(now())

  user User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([uploadedBy])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserEvent {
  id             Int       @id @default(autoincrement())
  userId         Int
  event          String
  payload        Json
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([userId, id])
  @@index([createdAt])
}
